                                     <?php } else { ?>

                                    <?php
                                        $no = 1;
                                        while($row = mysqli_fetch_assoc($stmt)) {
                                            $prod_id = isset($row['id']) ? $row['id'] : '';
                                            $prod_code = isset($row['prod_code']) ? $row['prod_code'] : '';
                                            $prod_name = isset($row['name']) ? $row['name'] : '';
                                            $category = isset($row['category']) ? $row['category'] : (isset($row['category_name']) ? $row['category_name'] : (isset($row['category_id']) ? $row['category_id'] : ''));
                                            $unit = isset($row['unit']) ? $row['unit'] : '';
                                            $selling_price = isset($row['selling_price']) ? $row['selling_price'] : 0;
                                            $stok = isset($row['qty']) ? $row['qty'] : '';
                                    ?>

                                    <tr>
                                        <td><?= $no++; ?></td>
                                        <td><?= htmlspecialchars($prod_code); ?></td>
                                        <td><?= htmlspecialchars($prod_name); ?></td>
                                        <td><?= htmlspecialchars($category); ?></td>
                                        <td><?= htmlspecialchars($unit); ?></td>
                                        <td>Rp <?= number_format($selling_price, 0, ',', '.'); ?></td>
                                        <td><?= htmlspecialchars($stok); ?></td>
                                        <td>-</td>
                                        <td>
                                            <button type="button" class="btn btn-info btn-xs" data-toggle="modal" data-target="#viewProd<?php echo $prod_id; ?>" title="View">
                                                <span class="glyphicon glyphicon-eye-open"></span>
                                            </button>
                                            <button type="button" class="btn btn-warning btn-xs" data-toggle="modal" data-target="#editProd<?php echo $prod_id; ?>" title="Edit">
                                                <span class="glyphicon glyphicon-edit"></span>
                                            </button>
                                            <button type="button" class="btn btn-danger btn-xs" data-toggle="modal" data-target="#deleteProd<?php echo $prod_id; ?>" title="Delete">
                                                <span class="glyphicon glyphicon-trash"></span>
                                            </button>
                                        </td>
                                    </tr>

                                    <?php } ?>

